# API key for the pairwise benchmark evaluator. Copy this file to .env and fill
# it in — the evaluator runs on Gemini 3.1 Pro and needs nothing else.
#
# Read by server/models.js in the Vite dev server (Node side). Vite only exposes
# VITE_-prefixed variables to browser code, so this never reaches the client bundle.

GOOGLE_API_KEY=