# API keys for the pairwise benchmark evaluator. Copy this file to .env and fill
# in the judges you intend to run.
#
# Read by server/models.js in the Vite dev server (Node side). Vite only exposes
# VITE_-prefixed variables to browser code, so these never reach the client bundle.
#
# Each judge keeps its own results directory (see server/judges.js), so you only
# need the key for the judge you are actually running.

# Gemini 3.1 Pro — the default judge, writes to benchmark_results/gemini/
GOOGLE_API_KEY=

# GPT-5.5 — writes to benchmark_results/gpt5.5/
OPENAI_API_KEY=
