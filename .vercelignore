# Only consulted when deploying from the CLI (`vercel --prod`). The production
# deploys here come from the GitHub integration, which builds a clone of the
# repo instead — so what actually reaches a build is decided by .gitignore, and
# this file is a fallback for the occasional manual push.

node_modules
dist
.venv
.env
scripts
public/contexts.xlsx

# screenshots/ and experiments/ are deliberately absent: the Outputs and
# Benchmark tabs are exported from them at build time.
